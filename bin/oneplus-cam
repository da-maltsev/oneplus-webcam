#!/usr/bin/env bash
set -euo pipefail

CONFIG="${ONEPLUS_CAM_CONFIG:-$HOME/.config/oneplus-cam.conf}"
PIDFILE="${ONEPLUS_CAM_PIDFILE:-$HOME/.local/state/oneplus-cam.pid}"

: "${SERIAL:=26c15cd6}"
: "${DEVICE:=/dev/video60}"
: "${CAMERA_ID:=0}"
: "${SIZE:=1920x1080}"
: "${FPS:=30}"
: "${ZOOM:=}"
: "${PREVIEW:=0}"

load_config() {
    if [[ -f "$CONFIG" ]]; then
        # shellcheck disable=SC1090
        source "$CONFIG"
    fi
}

save_config() {
    mkdir -p "$(dirname "$CONFIG")"
    cat > "$CONFIG" <<EOF
SERIAL=${SERIAL}
DEVICE=${DEVICE}
CAMERA_ID=${CAMERA_ID}
SIZE=${SIZE}
FPS=${FPS}
ZOOM=${ZOOM}
PREVIEW=${PREVIEW}
EOF
}

find_usb_serial() {
    adb devices | awk 'NR>1 && $2=="device" {print $1}' | head -1
}

cmd_start() {
    load_config
    local facing=back size="$SIZE" fps="$FPS" zoom="$ZOOM" camera_id="" preview="$PREVIEW"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --facing) facing="$2"; shift 2 ;;
            --size) size="$2"; shift 2 ;;
            --fps) fps="$2"; shift 2 ;;
            --camera-id) camera_id="$2"; shift 2 ;;
            --zoom) zoom="$2"; shift 2 ;;
            --preview) preview=1; shift ;;
            *) echo "Unknown option: $1"; exit 1 ;;
        esac
    done

    if [[ -n "$camera_id" ]]; then
        CAMERA_ID="$camera_id"
    elif [[ "$facing" == "front" ]]; then
        CAMERA_ID=1
    else
        CAMERA_ID=0
    fi

    local zoom_arg=()
    if [[ -n "$zoom" ]]; then
        zoom_arg=(--camera-zoom="$zoom")
    fi

    local window_arg=()
    if [[ "$preview" != "1" ]]; then
        window_arg=(--no-window)
    fi

    ZOOM="$zoom"
    SIZE="$size"
    FPS="$fps"
    PREVIEW="$preview"
    save_config

    local serial
    serial="$(find_usb_serial || true)"
    if [[ -z "$serial" ]]; then
        echo "No USB device found. Plug in the phone and run 'oneplus-cam status'."
        echo "If it shows 'unauthorized', accept the prompt on the phone (tick 'Always allow')."
        exit 1
    fi
    if ! adb devices | awk -v t="$serial" '$1==t && $2=="device" {f=1} END{exit !f}'; then
        echo "Device $serial is not authorized. Accept the prompt on the phone."
        exit 1
    fi

    if [[ ! -e "$DEVICE" ]]; then
        echo "ERROR: $DEVICE does not exist (v4l2loopback not loaded)."
        echo "Reload with: sudo modprobe -r v4l2loopback && sudo modprobe v4l2loopback"
        exit 1
    fi

    if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "Webcam already running (PID $(cat "$PIDFILE")). Use 'oneplus-cam stop' first."
        exit 1
    fi

    echo "Starting OnePlus webcam (id $CAMERA_ID, ${size}@${fps}) -> $DEVICE"
    mkdir -p "$(dirname "$PIDFILE")"
    nohup scrcpy -s "$serial" \
        --video-source=camera \
        --camera-id="$CAMERA_ID" \
        --camera-size="$size" \
        --camera-fps="$fps" \
        "${zoom_arg[@]}" \
        "${window_arg[@]}" \
        --stay-awake \
        --no-audio \
        --v4l2-sink="$DEVICE" \
        > /tmp/oneplus-cam.log 2>&1 &
    echo "$!" > "$PIDFILE"
    sleep 6
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "Webcam running (PID $(cat "$PIDFILE"))."
    else
        echo "scrcpy failed to start. Check /tmp/oneplus-cam.log"
        exit 1
    fi
}

cmd_stop() {
    if [[ -f "$PIDFILE" ]]; then
        local pid
        pid="$(cat "$PIDFILE")"
        kill "$pid" 2>/dev/null && echo "Stopped webcam (PID $pid)." || echo "Not running."
        rm -f "$PIDFILE"
    else
        if pgrep -f "scrcpy --video-source=camera" >/dev/null 2>&1; then
            pkill -f "scrcpy --video-source=camera" && echo "Stopped webcam."
        else
            echo "Webcam not running."
        fi
    fi
}

cmd_status() {
    load_config
    echo "--- adb devices ---"
    adb devices
    echo "--- webcam ---"
    if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "Streaming (PID $(cat "$PIDFILE")) -> $DEVICE"
    else
        echo "Not streaming."
    fi
}

cmd_state() {
    load_config
    local running=false pid=null
    local zoom="${ZOOM:-1}"
    if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        running=true
        pid="$(cat "$PIDFILE")"
    fi
    local connected=false authorized=false
    local dev_states
    dev_states="$(adb devices 2>/dev/null | awk 'NR>1 && $1 != "" {print $2}')" || true
    if [[ -n "$dev_states" ]]; then
        connected=true
    fi
    if echo "$dev_states" | grep -qx "device"; then
        authorized=true
    fi
    printf '{"running":%s,"pid":%s,"cameraId":%s,"zoom":%s,"size":"%s","fps":%s,"device":"%s","serial":"%s","connected":%s,"authorized":%s,"preview":%s}\n' \
        "$running" "$pid" "$CAMERA_ID" "$zoom" "$SIZE" "$FPS" "$DEVICE" "$SERIAL" "$connected" "$authorized" "$PREVIEW"
}

cmd_cams() {
    load_config
    local serial
    serial="$(find_usb_serial || true)"
    if [[ -z "$serial" ]]; then
        if [[ "${1:-}" == "--json" ]]; then
            echo "[]"
        else
            echo "No USB device found. Plug in the phone first."
        fi
        exit 1
    fi
    if [[ "${1:-}" == "--json" ]]; then
        scrcpy -s "$serial" --list-cameras 2>/dev/null | awk '
            BEGIN { printf "[" }
            /--camera-id=/ {
                line = $0
                id = ""
                facing = ""
                maxsize = ""
                zoom = ""
                if (match(line, /--camera-id=([0-9]+)/, m)) id = m[1]
                if (match(line, /\((back|front)/, m)) facing = m[1]
                if (match(line, /[0-9]+x[0-9]+/)) maxsize = substr(line, RSTART, RLENGTH)
                if (match(line, /zoom-range=\[([0-9]+), ([0-9]+)\]/, m)) zoom = m[1] "-" m[2]
                if (id != "") {
                    if (n++ > 0) printf ","
                    printf "{\"id\":%s,\"facing\":\"%s\",\"maxSize\":\"%s\",\"zoomRange\":\"%s\"}", id, facing, maxsize, zoom
                }
            }
            END { printf "]\n" }
        '
    else
        scrcpy -s "$serial" --list-cameras
    fi
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    stop) cmd_stop ;;
    status) cmd_status ;;
    state) cmd_state ;;
    cams) shift; cmd_cams "$@" ;;
    *)
        echo "Usage: oneplus-cam {start|stop|status|state|cams}"
        echo "  start [--facing back|front] [--camera-id N] [--zoom N] [--size WxH] [--fps N] [--preview]"
        echo "        --preview: open a preview window (default is headless)"
        echo "  state  machine-readable status (JSON)"
        echo "  cams [--json]   list available cameras"
        exit 1
        ;;
esac
